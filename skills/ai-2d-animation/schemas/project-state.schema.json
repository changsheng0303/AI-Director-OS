{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI 2D Animation Project State V1.7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "state",
    "assets",
    "scenes",
    "shots",
    "continuity",
    "qa"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.5", "1.6", "1.7"]
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "title"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "artifact_version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "required": [
        "current"
      ],
      "properties": {
        "current": {
          "type": "string",
          "enum": [
            "INTAKE",
            "FOUNDATION_DRAFT",
            "FOUNDATION_LOCKED",
            "INTENT_LOCKED",
            "BIBLE_LOCKED",
            "BEAT_LOCKED",
            "NARRATIVE_LOCKED",
            "SHOT_LOCKED",
            "ASSET_LOCKED",
            "PROMPT_READY",
            "ROUTE_READY",
            "GENERATING",
            "QA_REPAIR",
            "APPROVED",
            "EDITING",
            "FINAL"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "actor",
              "artifact_version"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "artifact_version": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "version"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": true
    },
    "qa": {
      "type": "object",
      "additionalProperties": true
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundation_id", "version", "content_hash", "status"],
      "properties": {
        "foundation_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "status": {"type": "string", "enum": ["DRAFT", "LOCKED", "INVALIDATED"]}
      }
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_id", "status", "scope", "reason"],
        "properties": {
          "change_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["proposed", "approved", "rejected", "applied"]},
          "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "reason": {"type": "string", "minLength": 1},
          "approved_by": {"type": "string"},
          "approved_at": {"type": "string"}
        }
      }
    },
    "artifact_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_type", "version", "content_hash", "parents", "canon_locked", "status"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_type": {
            "type": "string",
            "enum": ["ip_foundation", "creative_brief", "story_contract", "narrative_ir", "scene_contract", "shot_contract", "asset", "prompt", "generation", "editorial", "master"]
          },
          "version": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "parents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "canon_locked": {"type": "boolean"},
          "approved_change_id": {"type": "string"},
          "status": {"type": "string", "enum": ["DRAFT", "LOCKED", "INVALIDATED", "APPROVED", "SUPERSEDED"]},
          "validator": {"type": "string"}
        }
      }
    },
    "invalidation_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "cause_artifacts", "affected_artifacts", "timestamp"],
        "properties": {
          "event_id": {"type": "string"},
          "cause_artifacts": {"type": "array", "items": {"type": "string"}},
          "affected_artifacts": {"type": "array", "items": {"type": "string"}},
          "timestamp": {"type": "string"}
        }
      }
    }
  }
}
